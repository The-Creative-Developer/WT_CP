PORT=5050
# Must match RUNNER_TOKEN in server/.env
RUNNER_TOKEN=change-me-shared-secret-with-runner
MAX_CONCURRENT_RUNS=2
# Where code files are written before being mounted into sandboxes. Leave empty locally.
# In production the runner talks to the host's Docker, which resolves mount paths on the HOST: mount a host folder
# into the runner at the same path (e.g. /var/lib/devverse/runs:/var/lib/devverse/runs) and set it here.
RUNS_DIR=
