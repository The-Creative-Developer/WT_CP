# Settings for docker-compose.prod.yml. Copy to deploy/.env on the VM (gitignored) and fill in every value.
# See docs/deployment.md.

# The site's address. sslip.io turns the IP inside the name into DNS, so no domain is needed:
# for a droplet at 203.0.113.7, use https://devverse.203-0-113-7.sslip.io
PUBLIC_URL=https://devverse.203-0-113-7.sslip.io

# MongoDB Atlas connection string (Database → Connect → Drivers), with the database name before the "?".
MONGODB_URI=mongodb+srv://devverse:<password>@<cluster>.mongodb.net/devverse?retryWrites=true&w=majority

# Long random secrets. Generate each one with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
RUNNER_TOKEN=

# Optional until the AI assistant ships (Week 3).
ANTHROPIC_API_KEY=
