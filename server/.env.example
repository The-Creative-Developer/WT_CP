NODE_ENV=development
PORT=4000
# Local replica set from docker-compose (transactions need a replica set)
MONGODB_URI=mongodb://localhost:27017/devverse?replicaSet=rs0&directConnection=true
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars
RUNNER_URL=http://localhost:5050
RUNNER_TOKEN=change-me-shared-secret-with-runner
ANTHROPIC_API_KEY=
# Calls. Optional in development: without TURN, calls use STUN only (fine on most home networks).
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# TURN_SECRET=the-same-value-as-coturns-static-auth-secret
