{
  "name": "devverse",
  "version": "0.1.0",
  "private": true,
  "description": "DevVerse — a multiplayer coding world: collaborative editor, voice/video, sandboxed code execution, AI assistant, challenges and portfolios.",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "runner",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:all": "concurrently -n server,client,runner -c blue,magenta,green \"npm run dev -w server\" \"npm run dev -w client\" \"npm run dev -w runner\"",
    "build": "npm run build -w server -w runner -w client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "concepts": "node scripts/generate-concepts.mjs",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  }
}
